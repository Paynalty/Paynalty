# ========================================
# Spring 환경 설정
# ========================================
SPRING_PROFILES_ACTIVE=prod

# ========================================
# 서버 설정
# ========================================
SERVER_PORT=8080

# ========================================
# 데이터베이스 설정
# ========================================
# Docker Compose 사용 시 DB_HOST는 'db'로 설정
DB_HOST=db
DB_PORT=3306
DB_NAME=paynalty
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password_here

# ========================================
# AWS S3 설정
# ========================================
# S3 버킷 이름
AWS_S3_BUCKET=your-bucket-name
# AWS 리전 (서울: ap-northeast-2)
AWS_REGION=ap-northeast-2

# ========================================
# JWT 인증 설정
# ========================================
# 운영 환경에서는 반드시 랜덤한 긴 문자열로 변경
JWT_SECRET=your-super-secret-jwt-key-minimum-256-bits-change-this-in-production
# Access Token 유효 시간 (밀리초, 기본: 1시간)
JWT_ACCESS_TOKEN_VALIDITY=3600000
# Refresh Token 유효 시간 (밀리초, 기본: 7일)
JWT_REFRESH_TOKEN_VALIDITY=604800000

# ========================================
# JPA/Hibernate 설정 (선택사항)
# ========================================
# 첫 배포 시 테이블 자동 생성: update
# 운영 중 스키마 보호: validate
SPRING_JPA_HIBERNATE_DDL_AUTO=update